{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicStudio",
  "version": "0.1.0",
  "identifier": "com.minimax.music-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Music Studio",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMDMzRDAxOTM2QzBERkYKUldUL0RXeVRBVDBEa2lERnV1SkV0cHFBNWs5QXBrRFhEU1VTcEhpR1Z1WFV6dXVwMkpIUlFrM28K",
      "endpoints": [
        "https://github.com/maxfeng1979/music-studio/releases/latest/download/latest.json"
      ]
    }
  }
}